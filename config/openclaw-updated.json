{
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/anthropic",
        "apiKey": "sk-your-deepseek-api-key",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 65536
          },
          {
            "id": "deepseek-v4-flash",
            "name": "DeepSeek V4 Flash",
            "reasoning": false,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "auth": {
      "mode": "none",
      "token": "your-gateway-auth-token"
    },
    "nodes": {
      "allowCommands": [
        "system.run",
        "system.run.prepare",
        "system.which",
        "app.list",
        "app.launch",
        "app.force_stop",
        "input.tap",
        "input.swipe",
        "input.text",
        "input.key",
        "screen.info",
        "screen.capture",
        "clipboard.get",
        "clipboard.set",
        "shell.exec"
      ]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "deepseek/deepseek-v4-pro"
      },
      "thinkingDefault": "off"
    }
  },
  "plugins": {
    "entries": {
      "deepseek": {
        "enabled": true
      }
    }
  },
  "meta": {
    "lastTouchedVersion": "2026.5.6",
    "lastTouchedAt": "2026-05-07T07:02:22.610Z"
  }
}
